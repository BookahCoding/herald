<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- INFO so request headers, including the DashScope key, are not written out. -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
